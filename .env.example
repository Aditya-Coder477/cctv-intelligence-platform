# Sentinel CCTV Platform Configuration Example
# Copy to .env and configure as needed. DO NOT commit .env to version control.

# Catalogue Configuration
SENTINEL_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
CATALOGUE_SOURCE=live

# Authentication (optional credentials if Sentinel endpoint requires authorization)
SENTINEL_AUTH_EMAIL=
SENTINEL_AUTH_PASSWORD=
SENTINEL_AUTH_TOKEN=
SENTINEL_AUTH_COOKIE=

# Local Catalogue Fallback (used when CATALOGUE_SOURCE=local)
LOCAL_CATALOGUE_PATH=data/catalogue/normalized/cameras.json

# Stream Gateway Templates (from Sentinel Integrator Guide)
SENTINEL_RTSP_TEMPLATE=rtsp://103.250.160.189:8554/stream/{camera_id}
SENTINEL_HLS_TEMPLATE=https://cctv.corp8.cloud/{camera_id}/index.m3u8
SENTINEL_WEBRTC_TEMPLATE=http://103.250.160.189:8889/stream/{camera_id}/whep

# Streaming Configuration
DEFAULT_CAMERA_ID=cam01
RTSP_FORCE_TCP=true

# Logging
LOG_LEVEL=INFO
